# Copy to .env and adjust. All vars are prefixed with CUBEPY_.
CUBEPY_JWT_SECRET=change-me
CUBEPY_JWT_ALGORITHM=HS256

# Postgres or Hologres (Hologres speaks the PG wire protocol).
CUBEPY_PG_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/cubepy

CUBEPY_REDIS_URL=redis://localhost:6379/0
CUBEPY_CACHE_TTL_SECONDS=300
CUBEPY_DEFAULT_REFRESH_EVERY=30
CUBEPY_LOG_LEVEL=INFO

# AI ask layer (M2). OpenAI-compatible: DeepSeek / DashScope(qwen) / OpenAI / vLLM.
# The /cubepy/v1/ask router mounts only when CUBEPY_ASK_ENABLED=true (or a test
# injects an LLM). Demo script (run_server.py) falls back to FakeLLM without a key.
# CUBEPY_ASK_ENABLED=true
# CUBEPY_LLM_BASE_URL=https://api.deepseek.com/v1
# CUBEPY_LLM_API_KEY=sk-...
# CUBEPY_LLM_MODEL=deepseek-chat
# CUBEPY_LLM_TIMEOUT_SECONDS=30
# CUBEPY_ASK_INTERPRET=true
# CUBEPY_ASK_AUDIT_LOG=/var/log/cubepy/ask.jsonl
# 换业务域 = 换术语表（dotted path -> dict）
# CUBEPY_ASK_GLOSSARY=cubepy.samples.glossary_trade.TRADE_GLOSSARY
