# Copy to .env and adjust. All vars are prefixed with CUBEPY_.
CUBEPY_JWT_SECRET=change-me
CUBEPY_JWT_ALGORITHM=HS256

# Postgres or Hologres (Hologres speaks the PG wire protocol).
CUBEPY_PG_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/cubepy

CUBEPY_REDIS_URL=redis://localhost:6379/0
CUBEPY_CACHE_TTL_SECONDS=300
CUBEPY_DEFAULT_REFRESH_EVERY=30
CUBEPY_LOG_LEVEL=INFO
